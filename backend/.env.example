MONGODB_URI=mongodb://localhost:27017/minuslearn
MONGODB_DB=minuslearn
JWT_SECRET=development-only-change-me-at-least-32-bytes
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Mino local coach
OLLAMA_BASE_URL=http://127.0.0.1:11434
MASCOT_MODEL=qwen2.5:1.5b
MASCOT_TIMEOUT_SECONDS=30
MASCOT_MAX_TOKENS=220

# YouTube import resilience
# Recommended for a blocked/cloud IP: use one rotating residential proxy gateway.
# Keep credentials server-side and URL-encode special characters in user/password.
YOUTUBE_PROXY_URL=
# Optional yt-dlp fallback after solving a CAPTCHA. Use a Netscape-format cookie
# file and preferably a throwaway account; never commit this file.
YOUTUBE_COOKIES_FILE=
# yt-dlp recommends spacing bulk YouTube requests by roughly 5-10 seconds.
YOUTUBE_REQUEST_INTERVAL_SECONDS=5
YOUTUBE_TRANSCRIPT_CACHE_TTL_SECONDS=21600

# Transcript mode: local never calls the IP-blocked YouTube caption endpoint.
# Optional auto mode tries captions once, then opens a circuit breaker and uses
# local transcription for subsequent videos when captions are blocked.
YOUTUBE_TRANSCRIPT_MODE=local
YOUTUBE_WHISPER_MODEL=base.en
YOUTUBE_WHISPER_DEVICE=cpu
YOUTUBE_WHISPER_COMPUTE_TYPE=int8
YOUTUBE_WHISPER_MAX_DURATION_SECONDS=7200
